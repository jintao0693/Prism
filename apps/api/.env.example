# 应用
APP_NAME=Prism API
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-in-production

# 数据库（默认 SQLite 便于本地；生产改 Postgres）
DATABASE_URL=sqlite+aiosqlite:///./data/prism.db
# DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism

# Redis（可选；未配置时任务走进程内）
REDIS_URL=redis://localhost:6379/0

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 对象存储（本地演示可空，走本地目录）
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=prism

# Agent / LLM（未配置时走演示回复）
PRISM_AGENT_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=
# 是否强制演示模式（不调真实模型）
AGENT_DEMO_MODE=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
